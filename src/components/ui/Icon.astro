const strokes = {
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-down': 'M12 5v14M6 13l6 6 6-6',
  external: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  pin: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  check: 'M5 12.5l4.5 4.5L19 7.5',
};

export type IconName = keyof typeof paths | keyof typeof strokes;
interface Props {
  name: IconName;
  class?: string;
  size?: number;
}
const { name, class: className = '', size = 20 } = Astro.props;
const fill = name in paths ? paths[name as keyof typeof paths] : null;
const stroke = name in strokes ? strokes[name as keyof typeof strokes] : null;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  class={className}
  fill={fill ? 'currentColor' : 'none'}
  stroke={stroke ? 'currentColor' : 'none'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={fill ?? stroke ?? ''}></path>
</svg>
