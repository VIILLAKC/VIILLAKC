---
/** Página de detalle de un caso de éxito (la usan /casos/[id] y /en/cases/[id]). */
import type { CollectionEntry } from 'astro:content';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Starfield from '../journey/Starfield.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import Icon from '../ui/Icon.astro';
import { getLangFromUrl, useTranslations, t, casePath, localizePath } from '@/i18n/ui';
import { getProfile, getProjects, resolveStack } from '@/lib/content';
import { categoryColor } from '@/lib/categories';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
const lang = getLangFromUrl(Astro.url);
const tr = useTranslations(lang);
const home = localizePath('', lang);
const profile = await getProfile();
const stack = await resolveStack(p.stack);

// Mismo orden que en la portada (destacados primero) para "anterior / siguiente".
const cases = (await getProjects()).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const i = cases.findIndex((c) => c.id === project.id);
const prev = cases[(i - 1 + cases.length) % cases.length];
const next = cases[(i + 1) % cases.length];
const showNav = cases.length > 1;
---

<Starfield />
<SiteHeader />

<main id="main" class="relative z-10 pt-28 pb-20 sm:pt-36" style={`--cat:${categoryColor[p.category]}`}>
  <article class="container-page max-w-4xl">
    <a href={`${home}#projects`} class="group inline-flex min-h-11 items-center gap-2 text-sm text-muted transition-colors hover:text-ink">
      <Icon name="arrow-right" size={16} class="rotate-180 transition-transform group-hover:-translate-x-1" />
      {tr('projects.back')}
    </a>

    <header class="mt-6">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
        <span class="rounded-full bg-[var(--cat)]/15 px-3 py-1 font-semibold text-[var(--cat)]">{tr(`projects.cat.${p.category}`)}</span>
      </p>
      <h1 class="mt-5 text-4xl leading-tight font-bold text-balance sm:text-5xl">{t(p.title, lang)}</h1>
      <p class="mt-5 text-lg text-pretty text-muted sm:text-xl">{t(p.summary, lang)}</p>

      {
        (p.context || p.role) && (
          <dl class="mt-8 grid gap-4 border-y border-line py-5 text-sm sm:grid-cols-2">
            {p.context && (
              <div>
                <dt class="text-muted">{tr('projects.context')}</dt>
                <dd class="mt-1 font-medium text-ink">{t(p.context, lang)}</dd>
              </div>
            )}
            {p.role && (
              <div>
                <dt class="text-muted">{tr('projects.role')}</dt>
                <dd class="mt-1 font-medium text-ink">{t(p.role, lang)}</dd>
              </div>
            )}
          </dl>
        )
      }
    </header>

    {
      p.results.length > 0 && (
        <section aria-labelledby="results" class="mt-12">
          <h2 id="results" class="font-display text-sm font-semibold tracking-wider text-muted uppercase">
            {tr('projects.results')}
          </h2>
          <dl class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-[repeat(auto-fit,minmax(10rem,1fr))]">
            {p.results.map((r) => (
              <div class="flex flex-col-reverse justify-end rounded-2xl border border-line bg-white/[0.03] p-5">
                <dt class="mt-1 text-sm text-muted">{t(r.label, lang)}</dt>
                <dd class="font-display text-2xl font-bold whitespace-nowrap text-[var(--cat)] sm:text-3xl">{r.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <div class="mt-14 grid gap-10 md:grid-cols-2">
      {
        p.problem && (
          <section aria-labelledby="problem">
            <h2 id="problem" class="text-2xl font-bold">{tr('projects.problem')}</h2>
            <p class="mt-4 leading-relaxed text-pretty text-ink/85">{t(p.problem, lang)}</p>
          </section>
        )
      }
      {
        p.solution && (
          <section aria-labelledby="solution">
            <h2 id="solution" class="text-2xl font-bold">{tr('projects.solution')}</h2>
            <p class="mt-4 leading-relaxed text-pretty text-ink/85">{t(p.solution, lang)}</p>
          </section>
        )
      }
    </div>

    {
      p.highlights.length > 0 && (
        <section aria-labelledby="highlights" class="mt-14">
          <h2 id="highlights" class="text-2xl font-bold">{tr('projects.highlights')}</h2>
          <ul class="mt-4 space-y-3">
            {p.highlights.map((h) => (
              <li class="flex gap-3 text-ink/85">
                <Icon name="check" size={20} class="mt-0.5 shrink-0 text-[var(--cat)]" />
                {t(h, lang)}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      stack.length > 0 && (
        <section aria-labelledby="stack" class="mt-14">
          <h2 id="stack" class="text-2xl font-bold">{tr('projects.stack')}</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {stack.map((s) => (
              <li class="rounded-full border border-line bg-white/[0.03] px-3.5 py-1.5 text-sm text-ink/90">{s.name}</li>
            ))}
          </ul>
        </section>
      )
    }

    <aside class="mt-16 rounded-3xl border border-line bg-gradient-to-br from-white/[0.05] to-transparent p-6 sm:p-10">
      <h2 class="text-2xl font-bold sm:text-3xl">{tr('projects.cta.title')}</h2>
      <p class="mt-3 text-muted">{tr('projects.cta.body')}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        {profile.links.linkedin && (
          <ButtonLink href={profile.links.linkedin} icon="linkedin" external externalLabel={tr('common.external')}>LinkedIn</ButtonLink>
        )}
        <ButtonLink href={`${home}#experience`} variant="ghost" iconEnd="arrow-right">{tr('projects.cta.button')}</ButtonLink>
      </div>
    </aside>

    {
      showNav && (
        <nav aria-label={tr('projects.title')} class="mt-12 grid gap-4 sm:grid-cols-2">
          <a href={casePath(prev.id, lang)} class="group rounded-2xl border border-line p-5 transition-colors hover:border-white/25">
            <span class="flex items-center gap-1.5 text-xs text-muted">
              <Icon name="arrow-right" size={14} class="rotate-180" />
              {tr('projects.prev')}
            </span>
            <span class="mt-2 block font-display font-semibold group-hover:text-signal">{t(prev.data.title, lang)}</span>
          </a>
          <a href={casePath(next.id, lang)} class="group rounded-2xl border border-line p-5 text-right transition-colors hover:border-white/25">
            <span class="flex items-center justify-end gap-1.5 text-xs text-muted">
              {tr('projects.next')}
              <Icon name="arrow-right" size={14} />
            </span>
            <span class="mt-2 block font-display font-semibold group-hover:text-signal">{t(next.data.title, lang)}</span>
          </a>
        </nav>
      )
    }
  </article>
</main>

<div class="relative z-10 border-t border-line py-8">
  <SiteFooter />
</div>
