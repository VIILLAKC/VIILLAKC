---
import Section from '../ui/Section.astro';
import StackChips from '../ui/StackChips.astro';
import Disclosure from '../ui/Disclosure.astro';
import { getLangFromUrl, useTranslations, t, formatYearMonth } from '@/i18n/ui';
import { getExperience } from '@/lib/content';

const lang = getLangFromUrl(Astro.url);
const tr = useTranslations(lang);
const jobs = await getExperience();
const moreLabel = (n: number) => (n === 1 ? tr('experience.more.one') : tr('experience.more.other').replace('{n}', String(n)));
---

<Section id="experience" landmark="gas-giant" altitude={tr('alt.experience')} title={tr('experience.title')}>
  <ol class="experience-list relative ml-2 border-l border-line sm:ml-4">
    {
      jobs.map(({ data: j }) => (
        <li class="relative pb-12 pl-8 last:pb-0 sm:pl-12">
          <span
            class:list={[
              'absolute top-1.5 -left-[7px] size-3.5 rounded-full border-2',
              j.end === null ? 'border-terra bg-terra shadow-[0_0_16px_var(--color-terra)]' : 'border-signal bg-void',
            ]}
            aria-hidden="true"
          />
          <p class="text-sm text-muted">
            <time datetime={j.start}>{formatYearMonth(j.start, lang)}</time>
            {' — '}
            {j.end ? <time datetime={j.end}>{formatYearMonth(j.end, lang)}</time> : <span class="font-semibold text-terra">{tr('experience.present')}</span>}
          </p>
          <h3 class="mt-1 text-xl font-bold sm:text-2xl">{t(j.role, lang)}</h3>
          <p class="text-ink/80">
            {t(j.org, lang)}
            {j.location && <span class="text-muted"> · {t(j.location, lang)}</span>}
          </p>
          {j.highlights.length > 0 && (
            <ul class="mt-4 max-w-3xl list-disc pl-5 text-muted marker:text-signal">
              <li>{t(j.highlights[0], lang)}</li>
            </ul>
          )}
          {j.highlights.length > 1 ? (
            <Disclosure more={moreLabel(j.highlights.length - 1)} less={tr('experience.less')} class="mt-2" contentClass="pb-1">
              <ul class="max-w-3xl list-disc space-y-2 pl-5 text-muted marker:text-signal">
                {j.highlights.slice(1).map((h) => (
                  <li>{t(h, lang)}</li>
                ))}
              </ul>
              <StackChips refs={j.stack} class="mt-4" />
            </Disclosure>
          ) : (
            <StackChips refs={j.stack} class="mt-4" />
          )}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  /* El texto pasa por encima del gigante gaseoso: una sombra suave lo separa de las bandas claras. */
  :global(#experience :is(h2, h3, p, li, summary)) {
    text-shadow:
      0 1px 2px rgb(4 5 12 / 0.9),
      0 0 14px rgb(4 5 12 / 0.85);
  }
</style>
