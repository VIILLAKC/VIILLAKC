---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import StackChips from '../ui/StackChips.astro';
import { getLangFromUrl, useTranslations, t } from '@/i18n/ui';
import { categoryColor } from '@/lib/categories';

interface Props {
  project: CollectionEntry<'projects'>;
}
const p = Astro.props.project.data;
const lang = getLangFromUrl(Astro.url);
const tr = useTranslations(lang);
const color = categoryColor[p.category];
const links = [
  p.links.demo && { href: p.links.demo, label: tr('projects.demo') },
  p.links.repo && { href: p.links.repo, label: tr('projects.repo') },
].filter((l): l is { href: string; label: string } => Boolean(l));
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white/[0.03]" style={`--cat:${color}`}>
  <div class="aspect-[16/9] overflow-hidden bg-orbit">
    {
      p.image ? (
        <Image
          src={p.image}
          alt={p.imageAlt ? t(p.imageAlt, lang) : ''}
          widths={[320, 640]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
          class="size-full object-cover object-top"
        />
      ) : (
        <div
          class="grid size-full place-items-center"
          style="background: radial-gradient(circle at 70% 20%, color-mix(in oklab, var(--cat) 45%, transparent), transparent 60%), var(--color-orbit)"
          aria-hidden="true"
        >
          <span class="font-display text-4xl font-bold text-white/80">{t(p.title, lang).slice(0, 2)}</span>
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h4 class="font-display text-lg font-bold">{t(p.title, lang)}</h4>
    <p class="mt-1 text-sm text-muted">{t(p.summary, lang)}</p>
    <StackChips refs={p.stack} class="mt-4" />
    {
      links.length > 0 && (
        <p class="mt-auto flex gap-4 pt-4 text-sm">
          {links.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-signal hover:text-ink"
            >
              {l.label}
              <span class="sr-only">— {t(p.title, lang)} {tr('common.external')}</span>
              <Icon name="external" size={16} />
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>
