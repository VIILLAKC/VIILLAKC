---
import Section from '../ui/Section.astro';
import StackChips from '../ui/StackChips.astro';
import Icon from '../ui/Icon.astro';
import Disclosure from '../ui/Disclosure.astro';
import { getLangFromUrl, useTranslations, t } from '@/i18n/ui';
import { getServices } from '@/lib/content';

const lang = getLangFromUrl(Astro.url);
const tr = useTranslations(lang);
const services = await getServices();
const planetSize = { sm: 'size-14', md: 'size-[4.5rem]', lg: 'size-[5.5rem]' };
---

<Section id="specialties" landmark="moon" altitude={tr('alt.services')} title={tr('services.title')} intro={tr('services.intro')}>
  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-planets>
    {
      services.map(({ id, data: s }) => (
        <li
          id={`service-${id}`}
          class="service-card relative isolate flex flex-col overflow-hidden rounded-3xl border border-line bg-white/[0.03] p-6 transition-colors duration-300 hover:border-white/20 sm:p-8"
          style={`--planet:${s.planet.color};--glow:${s.planet.glow}`}
        >
          {/* Satélite decorativo (ya en órbita terrestre): el cursor lo empuja (resorte en JS), su brillo sigue al cursor. */}
          <div class="planet-stage relative mb-6 flex h-28 items-center pl-14" aria-hidden="true" data-planet-stage>
            <span class="planet-float block">
              <span class="planet-spring block" data-planet>
                <span class:list={['planet-scale relative block', planetSize[s.planet.size]]}>
                  <span class="sat-panel sat-panel-l" />
                  <span class="sat-panel sat-panel-r" />
                  {s.planet.ring && <span class="sat-dish" />}
                  <span class="sat-body">
                    <span class="planet-light" />
                  </span>
                  <span class="sat-beacon" />
                </span>
              </span>
            </span>
          </div>

          <h3 class="text-2xl font-bold">{t(s.title, lang)}</h3>
          <p class="mt-2 font-medium text-[var(--glow)]">{t(s.tagline, lang)}</p>
          <p class="mt-4 text-muted">{t(s.description, lang)}</p>

          <Disclosure more={tr('services.more')} less={tr('services.less')} class="mt-4">
            <h4 class="mt-2 font-display text-sm font-semibold tracking-wider text-ink uppercase">{tr('services.evidence')}</h4>
            <ul class="mt-3 space-y-2 text-sm text-ink/90">
              {s.evidence.map((o) => (
                <li class="flex gap-2">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-[var(--planet)]" />
                  {t(o, lang)}
                </li>
              ))}
            </ul>

            <h4 class="mt-6 font-display text-sm font-semibold tracking-wider text-ink uppercase">{tr('services.practices')}</h4>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted marker:text-[var(--planet)]">
              {s.practices.map((d) => <li>{t(d, lang)}</li>)}
            </ul>
          </Disclosure>

          <StackChips refs={s.stack} class="mt-auto pt-6" />
        </li>
      ))
    }
  </ul>

</Section>

<script>
  import { initPlanets } from '../../scripts/planets.ts';

  // Se activa solo cuando la sección se acerca a la pantalla.
  const list = document.querySelector<HTMLElement>('[data-planets]');
  if (list) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        initPlanets(list);
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(list);
  }
</script>

<style>
  /* Destello que sigue al cursor dentro de la tarjeta (solo transform/opacity). */
  .service-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 0;
    top: 0;
    width: 26rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--planet) 16%, transparent), transparent);
    transform: translate(calc(var(--mx, 0px) - 13rem), calc(var(--my, 0px) - 13rem));
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover::before {
      opacity: 1;
    }
  }

  .planet-stage {
    cursor: grab;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .planet-float {
    animation: float 7s ease-in-out infinite alternate;
  }
  .service-card:nth-child(2) .planet-float {
    animation-delay: -2.3s;
  }
  .service-card:nth-child(3) .planet-float {
    animation-delay: -4.6s;
  }
  @keyframes float {
    from {
      transform: translateY(-5px) rotate(-2deg);
    }
    to {
      transform: translateY(5px) rotate(2deg);
    }
  }

  .planet-spring {
    transform: translate3d(var(--sx, 0px), var(--sy, 0px), 0) rotate(var(--sr, 0deg));
  }

  .planet-scale {
    transition: transform 0.5s var(--ease-out-expo);
  }
  .service-card:hover .planet-scale,
  .service-card:focus-within .planet-scale {
    transform: scale(1.1);
  }

  /* Cuerpo metálico teñido con el color de la especialidad. */
  .sat-body {
    position: absolute;
    inset: 24% 30%;
    z-index: 2;
    border-radius: 0.4rem;
    overflow: hidden;
    background:
      repeating-linear-gradient(90deg, transparent 0 22%, rgb(0 0 0 / 0.18) 22% 25%),
      linear-gradient(160deg, color-mix(in oklab, var(--planet) 70%, white), color-mix(in oklab, var(--planet) 45%, #1a1f33) 70%);
    box-shadow:
      0 0 36px -8px var(--planet),
      inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }
  /* Reflejo que se desplaza hacia el cursor. */
  .planet-light {
    position: absolute;
    width: 220%;
    aspect-ratio: 1;
    left: -80%;
    top: -90%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.55), transparent 60%);
    transform: translate(calc(var(--lx, 0) * 20%), calc(var(--ly, 0) * 20%));
    transition: transform 0.5s var(--ease-out-expo);
  }

  /* Paneles solares a ambos lados; se inclinan al pasar el cursor. */
  .sat-panel {
    position: absolute;
    top: 38%;
    height: 24%;
    width: 72%;
    z-index: 1;
    border: 1px solid color-mix(in oklab, var(--glow) 45%, transparent);
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.2) 0 1px, transparent 1px 20%),
      linear-gradient(180deg, #2a55b8, #0f2a66);
    box-shadow: 0 0 14px -4px rgb(80 140 255 / 0.6);
    transition: transform 0.6s var(--ease-out-expo);
  }
  .sat-panel-l {
    right: 66%;
  }
  .sat-panel-r {
    left: 66%;
  }
  .service-card:hover .sat-panel,
  .service-card:focus-within .sat-panel {
    transform: perspective(200px) rotateX(55deg);
  }

  /* Antena parabólica sobre el cuerpo. */
  .sat-dish {
    position: absolute;
    left: 50%;
    top: 0;
    width: 34%;
    height: 17%;
    z-index: 3;
    translate: -50% 0;
    rotate: -20deg;
    border-radius: 0 0 999px 999px;
    background: radial-gradient(ellipse at 50% 0%, #e9edf7, #8f97ad 70%);
  }
  .sat-dish::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 2px;
    height: 60%;
    translate: -50% 0;
    background: #9aa3bb;
  }

  /* Baliza que parpadea con el color de la especialidad. */
  .sat-beacon {
    position: absolute;
    right: 32%;
    bottom: 26%;
    width: 5px;
    height: 5px;
    z-index: 3;
    border-radius: 50%;
    background: var(--glow);
    box-shadow: 0 0 8px 2px var(--glow);
    animation: beacon 2.4s steps(1) infinite;
  }
  .service-card:nth-child(2) .sat-beacon {
    animation-delay: -0.8s;
  }
  .service-card:nth-child(3) .sat-beacon {
    animation-delay: -1.6s;
  }
  @keyframes beacon {
    0%,
    100% {
      opacity: 1;
    }
    12% {
      opacity: 0.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .planet-float,
    .sat-beacon {
      animation: none;
    }
  }
</style>
