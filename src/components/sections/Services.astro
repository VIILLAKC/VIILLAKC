---
import Section from '../ui/Section.astro';
import StackChips from '../ui/StackChips.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import Icon from '../ui/Icon.astro';
import { getLangFromUrl, useTranslations, t } from '@/i18n/ui';
import { getServices } from '@/lib/content';

const lang = getLangFromUrl(Astro.url);
const tr = useTranslations(lang);
const services = await getServices();
const planetSize = { sm: 'size-14', md: 'size-[4.5rem]', lg: 'size-[5.5rem]' };
---

<Section id="services" altitude={tr('alt.services')} title={tr('services.title')} intro={tr('services.intro')}>
  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-planets>
    {
      services.map(({ id, data: s }) => (
        <li
          id={`service-${id}`}
          class="service-card relative isolate flex flex-col overflow-hidden rounded-3xl border border-line bg-white/[0.03] p-6 transition-colors duration-300 hover:border-white/20 sm:p-8"
          style={`--planet:${s.planet.color};--glow:${s.planet.glow}`}
        >
          {/* Planeta decorativo: el cursor lo empuja (resorte en JS), su luz sigue al cursor y rebota al tocarlo. */}
          <div class="planet-stage relative mb-6 flex h-28 items-center pl-8" aria-hidden="true" data-planet-stage>
            <span class="planet-float block">
              <span class="planet-spring block" data-planet>
                <span class:list={['planet-scale relative block', planetSize[s.planet.size]]}>
                  {s.planet.ring && <span class="ring ring-back" />}
                  <span class="planet">
                    <span class="planet-light" />
                  </span>
                  {s.planet.ring && <span class="ring ring-front" />}
                  <span class="moon-x">
                    <span class="moon-y">
                      <span class="moon" />
                    </span>
                  </span>
                </span>
              </span>
            </span>
          </div>

          <h3 class="text-2xl font-bold">{t(s.title, lang)}</h3>
          <p class="mt-2 font-medium text-[var(--glow)]">{t(s.tagline, lang)}</p>
          <p class="mt-4 text-muted">{t(s.description, lang)}</p>

          <h4 class="mt-6 font-display text-sm font-semibold tracking-wider text-ink uppercase">{tr('services.outcomes')}</h4>
          <ul class="mt-3 space-y-2 text-sm text-ink/90">
            {s.outcomes.map((o) => (
              <li class="flex gap-2">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-[var(--planet)]" />
                {t(o, lang)}
              </li>
            ))}
          </ul>

          <h4 class="mt-6 font-display text-sm font-semibold tracking-wider text-ink uppercase">{tr('services.deliverables')}</h4>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted marker:text-[var(--planet)]">
            {s.deliverables.map((d) => <li>{t(d, lang)}</li>)}
          </ul>

          <StackChips refs={s.stack} class="mt-auto pt-6" />
        </li>
      ))
    }
  </ul>

  <div class="mt-12 flex justify-center">
    <ButtonLink href="#contact" variant="thrust" iconEnd="arrow-right">{tr('services.cta')}</ButtonLink>
  </div>
</Section>

<script>
  import { initPlanets } from '../../scripts/planets.ts';

  // Se activa solo cuando la sección se acerca a la pantalla.
  const list = document.querySelector<HTMLElement>('[data-planets]');
  if (list) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        initPlanets(list);
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(list);
  }
</script>

<style>
  /* Destello que sigue al cursor dentro de la tarjeta (solo transform/opacity). */
  .service-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 0;
    top: 0;
    width: 26rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--planet) 16%, transparent), transparent);
    transform: translate(calc(var(--mx, 0px) - 13rem), calc(var(--my, 0px) - 13rem));
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover::before {
      opacity: 1;
    }
  }

  .planet-stage {
    cursor: grab;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .planet-float {
    animation: float 7s ease-in-out infinite alternate;
  }
  .service-card:nth-child(2) .planet-float {
    animation-delay: -2.3s;
  }
  .service-card:nth-child(3) .planet-float {
    animation-delay: -4.6s;
  }
  @keyframes float {
    from {
      transform: translateY(-5px) rotate(-2deg);
    }
    to {
      transform: translateY(5px) rotate(2deg);
    }
  }

  .planet-spring {
    transform: translate3d(var(--sx, 0px), var(--sy, 0px), 0) rotate(var(--sr, 0deg));
  }

  .planet-scale {
    transition: transform 0.5s var(--ease-out-expo);
  }
  .service-card:hover .planet-scale,
  .service-card:focus-within .planet-scale {
    transform: scale(1.1);
  }

  .planet {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 50%;
    overflow: hidden;
    background:
      repeating-linear-gradient(-18deg, transparent 0 9%, rgb(255 255 255 / 0.07) 9% 14%, transparent 14% 22%),
      radial-gradient(circle at 50% 50%, var(--planet), color-mix(in oklab, var(--planet) 55%, black));
    box-shadow: 0 0 44px -8px var(--planet);
  }
  /* Luz y terminador en una sola capa que se desplaza hacia el cursor. */
  .planet-light {
    position: absolute;
    width: 200%;
    aspect-ratio: 1;
    left: -68%;
    top: -70%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--glow) 80%, white) 0%,
      color-mix(in oklab, var(--glow) 35%, transparent) 22%,
      transparent 42%,
      rgb(2 4 16 / 0.55) 72%,
      rgb(2 4 16 / 0.8) 100%
    );
    transform: translate(calc(var(--lx, 0) * 14%), calc(var(--ly, 0) * 14%));
    transition: transform 0.5s var(--ease-out-expo);
  }

  /* Anillo en dos mitades: la trasera pasa detrás del planeta, la delantera por encima. */
  .ring {
    position: absolute;
    inset: 36% -42%;
    border-radius: 50%;
    border: 2px solid color-mix(in oklab, var(--glow) 75%, transparent);
    box-shadow: 0 0 10px -2px var(--glow);
    rotate: -18deg;
    transition: rotate 0.6s var(--ease-out-expo);
  }
  .ring-back {
    z-index: 0;
  }
  .ring-front {
    z-index: 2;
    clip-path: inset(50% 0 0 0);
  }
  .service-card:hover .ring,
  .service-card:focus-within .ring {
    rotate: -6deg;
  }

  /* Luna: dos osciladores (x, y) desfasados ¼ de periodo dibujan una órbita elíptica. */
  .moon-x,
  .moon-y {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .moon-x {
    z-index: 3;
    animation: moon-x 5s ease-in-out infinite alternate;
  }
  .moon-y {
    animation: moon-y 5s ease-in-out infinite alternate;
    animation-delay: -2.5s;
  }
  .moon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f3f5ff, #8b93b8 70%);
    box-shadow: 0 0 6px rgb(255 255 255 / 0.35);
  }
  @keyframes moon-x {
    from {
      transform: translateX(-88%);
    }
    to {
      transform: translateX(88%);
    }
  }
  @keyframes moon-y {
    from {
      transform: translateY(-34%) scale(0.65);
      opacity: 0.5;
    }
    to {
      transform: translateY(34%) scale(1.1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .planet-float,
    .moon-x,
    .moon-y {
      animation: none;
    }
    .moon-x {
      transform: translateX(80%);
    }
  }
</style>
