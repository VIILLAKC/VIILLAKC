---
/**
 * Cielo estrellado 100 % CSS: cada capa es un punto de 1px con cientos de `box-shadow`.
 * Las posiciones se calculan al compilar (semilla fija), así que no hay JS ni imágenes.
 * El parallax y el desvanecimiento usan las variables --p (progreso del scroll) que pone journey.ts.
 */
const FIELD = 2400; // px cubiertos por cada capa (más alto que el viewport + el desplazamiento máximo)

function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function stars(count: number, seed: number, palette: string[]) {
  const rand = mulberry32(seed);
  return Array.from({ length: count }, () => {
    const x = Math.round(rand() * FIELD);
    const y = Math.round(rand() * FIELD);
    const color = palette[Math.floor(rand() * palette.length)];
    return `${x}px ${y}px ${color}`;
  }).join(',');
}

const layers = [
  { cls: 'far', shadow: stars(220, 7, ['#ffffff99', '#c9d6ff88', '#ffffff66']) },
  { cls: 'mid', shadow: stars(80, 21, ['#ffffffcc', '#9ff2ffaa', '#ffe2c4aa']) },
  { cls: 'near', shadow: stars(28, 42, ['#ffffff', '#9ff2ff', '#ffd9b0']) },
];
---

<div class="starfield" aria-hidden="true" data-journey>
  {layers.map((l) => <span class:list={['stars', l.cls]} style={`box-shadow:${l.shadow}`} />)}
  <span class="shooting-star"></span>
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 80% 10%, rgb(139 123 255 / 0.12), transparent 70%),
      radial-gradient(ellipse 50% 35% at 10% 30%, rgb(94 230 255 / 0.08), transparent 70%),
      var(--color-void);
    /* Las estrellas se apagan al entrar en la atmósfera. */
    opacity: calc(1 - var(--p, 0) * 0.85);
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    will-change: transform;
  }
  .far {
    transform: translate3d(0, calc(var(--p, 0) * -300px), 0);
  }
  .mid {
    width: 1.5px;
    height: 1.5px;
    transform: translate3d(0, calc(var(--p, 0) * -600px), 0);
  }
  .near {
    width: 2px;
    height: 2px;
    transform: translate3d(0, calc(var(--p, 0) * -900px), 0);
    animation: twinkle 3.5s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    to {
      opacity: 0.45;
    }
  }

  .shooting-star {
    position: absolute;
    top: 12%;
    left: 70%;
    width: 140px;
    height: 1px;
    background: linear-gradient(90deg, #fff, transparent);
    opacity: 0;
    transform: rotate(-25deg);
    animation: shoot 14s linear 3s infinite;
  }
  @keyframes shoot {
    0% {
      opacity: 0;
      transform: rotate(-25deg) translateX(0);
    }
    1% {
      opacity: 1;
    }
    5% {
      opacity: 0;
      transform: rotate(-25deg) translateX(-480px);
    }
    100% {
      opacity: 0;
      transform: rotate(-25deg) translateX(-480px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars {
      transform: none;
    }
    .near,
    .shooting-star {
      animation: none;
    }
  }
</style>
